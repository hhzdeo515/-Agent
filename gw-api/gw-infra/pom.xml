<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.guangxuan</groupId>
    <artifactId>gw-audit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gw-infra</artifactId>
  <name>gw-infra</name>
  <description>持久层、Redis 队列、MinIO 存储、百炼 Provider 实现</description>

  <dependencies>
    <dependency>
      <groupId>com.guangxuan</groupId>
      <artifactId>gw-domain</artifactId>
    </dependency>

    <!-- 持久层 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 数据库迁移：Flyway 负责建表、触发器、视图 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- 队列 / 缓存 / 幂等键（部署 Redis 7.2.x 或 Valkey，勿用 Redis 8，见 06 §2.1） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 对象存储 -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!-- 调用百炼：使用 RestClient，不需要 WebFlux -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 结构化输出契约的服务端校验（03 §7.3） -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!--
      文档解析：优先取文本层，比送 OCR 又准又便宜（docs/03 §4）。
      PDFBox 负责 PDF（含渲染页面图，供扫描件走 OCR 兜底）；
      POI 负责 DOCX / PPTX 的文字与结构抽取。
      两者均为 Apache-2.0，作为库依赖不触发传染（docs/06 §2）。
    -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.3.0</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>

# ============================================================================
# 广宣法务审核 Agent —— 环境变量示例
#
# 用法：
#   cd deploy
#   copy .env.example .env      # Windows
#   # 编辑 .env，至少填 DASHSCOPE_API_KEY 并把 GW_AI_PROVIDER 改成 dashscope
#   docker compose up -d
#
# ⚠️ .env 已被 .gitignore 忽略，不要把它提交到仓库。
# ============================================================================

# ── AI 供应商 ───────────────────────────────────────────────────────────────
# mock      = 规则实现，无需 Key，但只有关键词匹配能力，图片/视频/PDF 一律无法解析
# dashscope = 阿里云百炼千问大模型（推荐）
GW_AI_PROVIDER=mock

# 阿里云百炼 API Key（形如 sk-xxxxxxxx）
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY 管理
# ⚠️ 华北2（北京）与新加坡的 Key 不通用。本项目 region 固定为 cn-beijing，
#    请使用北京区域的 Key，否则会报 InvalidApiKey。
DASHSCOPE_API_KEY=

# 一般不需要改。若使用业务空间专属域名（性能与稳定性更好）：
#   DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
#   DASHSCOPE_COMPAT_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 模型型号（不填则用 application.yml 里的默认值）──────────────────────────
# 建议锁快照版本号而不是 -latest 别名，避免供应商侧更新导致行为漂移
# GW_MODEL_TEXT=qwen-plus
# GW_MODEL_VISION=qwen3-vl-8b-thinking
# GW_MODEL_OCR_PRIMARY=qwen-vl-ocr
# GW_MODEL_OCR_FALLBACK=qwen3.5-ocr
# GW_MODEL_ASR=qwen3-asr-flash-filetrans
# GW_MODEL_EMBEDDING=text-embedding-v4
# GW_MODEL_RERANK=qwen3-rerank

# ── 模型调用超时与重试 ──────────────────────────────────────────────────────
# 视觉与 OCR 是长请求，读超时给太短会表现为"随机失败"，很难排查
# GW_AI_CONNECT_TIMEOUT_MS=10000
# GW_AI_READ_TIMEOUT_MS=120000
# GW_AI_MAX_ATTEMPTS=3
# GW_AI_BACKOFF_BASE_MS=800

# ── 数据库 ──────────────────────────────────────────────────────────────────
GW_DB_NAME=gw_audit
GW_DB_USER=gw_audit
GW_DB_PASSWORD=gw_audit
GW_DB_ROOT_PASSWORD=root
GW_DB_PORT=3307

# ── 其他端口（本机 3306/6379/9000/9001 常被其他项目占用，故错开）────────────
GW_REDIS_PORT=6381
GW_MINIO_PORT=9002
GW_MINIO_CONSOLE_PORT=9003
GW_APP_PORT=8080

# ── 对象存储 ────────────────────────────────────────────────────────────────
GW_MINIO_ACCESS_KEY=minioadmin
GW_MINIO_SECRET_KEY=minioadmin
GW_MINIO_BUCKET=gw-audit

# ── 安全 ────────────────────────────────────────────────────────────────────
# 生产必须改成随机值，长度 ≥32 字节
GW_JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes

# ── 日志 ────────────────────────────────────────────────────────────────────
GW_LOG_LEVEL=INFO
